# Staging overlay for LOCAL runs only (APP_ENV=staging npm run start:staging).
# These override the production values from .env. EAS builds do NOT use this
# file — they read the `staging` profile env block in eas.json.
# Values are public (publishable anon key + public URLs), safe to commit.
EXPO_PUBLIC_APP_VARIANT=staging
EXPO_PUBLIC_SUPABASE_URL=https://gcaozgnevvmnlxnkfthh.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_c11B_LhCkB2c-F5GtAhcog_zA4GnZYr
EXPO_PUBLIC_API_URL=https://runeasyv2-staging.up.railway.app
# Web client do projeto Google da staging — define o `aud` do id_token, que o
# Supabase de staging valida. iOS/Android client IDs continuam os de .env (mesmo
# projeto GCP 911159721571), só o web client muda por ambiente.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=911159721571-3t3nmmu8kvi3lpr1s5dqg8lt7p275bdt.apps.googleusercontent.com
