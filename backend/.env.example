# ============================================
# SUPABASE
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key


# ============================================
# ANTHROPIC (Claude AI)
# ============================================
ANTHROPIC_API_KEY=sk-ant-...

# ============================================
# MAPBOX
# ============================================
# Server-side token used by the elevation enrichment job to fetch Terrain-DEM
# tiles (mapbox.mapbox-terrain-dem-v1). A public pk.* token works; ideally a
# separate restricted token. Without it, runs keep GPS-based elevation.
MAPBOX_ACCESS_TOKEN=pk....

# ============================================
# APP
# ============================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# ============================================
# REVENUECAT WEBHOOK
# ============================================
# Shared secret used by RevenueCat to authenticate POST /webhooks/revenuecat.
# Configure the same value in the RevenueCat dashboard under Project Settings →
# Webhooks → Authorization header. Format: Bearer <secret>
REVENUECAT_WEBHOOK_SECRET=replace_me_with_long_random_string

# Staging webhook secret — used ONLY by scripts/sim-revenuecat.ts with `--env
# staging` to authenticate against the staging Railway service (which has its own
# secret). Copy it from the staging service's Railway variables. If unset, the
# script falls back to REVENUECAT_WEBHOOK_SECRET (works only if both share it).
REVENUECAT_WEBHOOK_SECRET_STAGING=replace_me_with_staging_secret
