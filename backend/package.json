{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:int": "jest --config ./jest-integration.json --runInBand",
    "db:test:up": "docker compose -f ../docker-compose.yml --profile test up -d postgres-test",
    "db:test:down": "docker compose -f ../docker-compose.yml --profile test down postgres-test",
    "ai:stress-test": "ts-node scripts/ai-audit-stress-test.ts",
    "qa:ai-cost-audit": "ts-node scripts/ai-cost-audit.ts",
    "qa:sim-revenuecat": "ts-node scripts/sim-revenuecat.ts",
    "qa:sim-revenuecat:staging": "ts-node scripts/sim-revenuecat.ts --env staging",
    "qa:sim-revenuecat:prod": "ts-node scripts/sim-revenuecat.ts --env production",
    "qa:sim-workouts": "ts-node scripts/sim-workouts.ts",
    "qa:sim-workouts:retro-1a": "ts-node scripts/sim-workouts.ts --env staging --completions 5 --free-runs 1 --free-run-km 8 --rpe --generate-retrospective",
    "qa:sim-workouts:week-2a": "ts-node scripts/sim-workouts.ts --env staging --week 2 --completions 3 --completion-ratio 1.0 --free-runs 1 --free-run-km 6 --rpe --generate-weekly-insight"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/throttler": "^6.5.0",
    "@supabase/supabase-js": "^2.47.0",
    "@turf/turf": "^7.3.4",
    "@types/geojson": "^7946.0.16",
    "@types/pngjs": "^6.0.5",
    "axios": "^1.7.0",
    "bullmq": "^5.66.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "firebase-admin": "^13.6.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.8.2",
    "pngjs": "^7.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "roots": [
      "<rootDir>",
      "<rootDir>/../scripts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
